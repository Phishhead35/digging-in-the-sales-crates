# ── Dependencies ──────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────
/build
/dist
/.cache

# ── Secrets ───────────────────────────────────────────────────
# Anything matching these never gets committed. If a file needs to
# hold a credential, name it so it lands here.
.env
.env.*
!.env.example
*.local
secrets.*
credentials.*
*-secrets.txt
*credentials*.txt
*password*.txt
.dev.vars

# Cloudflare Workers local state
.wrangler/

# ── OS / editor cruft ─────────────────────────────────────────
# desktop.ini is currently tracked in this repo. After adding this
# file, remove it from tracking with:
#   git rm --cached desktop.ini
desktop.ini
Thumbs.db
.DS_Store
*.swp
*~
.idea/
.vscode/
!.vscode/extensions.json

# ── Logs ──────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
